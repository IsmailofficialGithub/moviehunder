# Mobile (Expo / React Native) Environment Configuration

# Backend API & Play Relay URLs (Use LAN IP for physical device testing, e.g. http://192.168.1.30:8787)
EXPO_PUBLIC_API_BASE=http://127.0.0.1:8787
EXPO_PUBLIC_PLAY_RELAY=http://127.0.0.1:8788

# Application Security Key (Must match APP_CLIENT_KEY in server/.env)
EXPO_PUBLIC_APP_CLIENT_KEY=your_secret_app_client_key_here

# Public Updates & Releases URLs
EXPO_PUBLIC_VERSION_JSON_URL=https://raw.githubusercontent.com/IsmailofficialGithub/moviehunder/main/version.json
EXPO_PUBLIC_GITHUB_RELEASES_URL=https://github.com/IsmailofficialGithub/moviehunder/releases

# Audius Music Feature Config (Optional)
EXPO_PUBLIC_AUDIUS_API_BASE=https://discoveryprovider.audius.co
EXPO_PUBLIC_AUDIUS_APP_NAME=MovieHunter

# CI/CD Release Script Environment Variables (Optional - for build & release automation)
RELEASE_PLATFORM=android
RELEASE_NOTES=Initial release
EAS_PROFILE=production
GITHUB_REPO=IsmailofficialGithub/moviehunder
GITHUB_TOKEN=your_github_token_here
