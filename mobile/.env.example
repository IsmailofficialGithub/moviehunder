# API must be reachable from your phone (use your PC LAN IP, not 127.0.0.1).
# Example: EXPO_PUBLIC_API_BASE=http://192.168.1.30:8787

EXPO_PUBLIC_API_BASE=http://127.0.0.1:8787
EXPO_PUBLIC_PLAY_RELAY=http://127.0.0.1:8788

# Subtitles: add SUBDL_API_KEY to server/.dev.vars (free from https://subdl.com)
# Mobile uses EXPO_PUBLIC_API_BASE for /api/subtitles/search and /download

# Spotify: not used — Songs tab uses free Audius via /api/music/*

# Offline music re-download fallback (same values as server AUDIUS_*)
EXPO_PUBLIC_AUDIUS_API_BASE=https://api.audius.co/v1
EXPO_PUBLIC_AUDIUS_APP_NAME=MovieHunter

# Must match server APP_CLIENT_KEY (API CORS / client gate)
EXPO_PUBLIC_APP_CLIENT_KEY=change-me-to-a-long-random-string

# App update (self-hosted / GitHub Releases — not Play Store required)
# Raw version.json URL (GitHub raw, jsDelivr, your CDN, etc.)
EXPO_PUBLIC_VERSION_JSON_URL=https://raw.githubusercontent.com/YOUR_ORG/YOUR_REPO/main/version.json
# Releases page (opened if APK install isn't available, e.g. Expo Go)
EXPO_PUBLIC_GITHUB_RELEASES_URL=https://github.com/YOUR_ORG/YOUR_REPO/releases
