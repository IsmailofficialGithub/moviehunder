# Web (Next.js) Environment Configuration

# Backend API & Play Relay URLs
NEXT_PUBLIC_API_BASE=https://trackese.api
NEXT_PUBLIC_PLAY_RELAY=https://trackese.api

# Application Security Key (Server-side only — DO NOT prefix with NEXT_PUBLIC_)
APP_CLIENT_KEY=your_secret_app_client_key_here

# Public URLs & Repositories
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_URL=https://github.com/IsmailofficialGithub
NEXT_PUBLIC_VERSION_JSON_URL=https://raw.githubusercontent.com/IsmailofficialGithub/moviehunder/main/version.json

# Server-side API Integrations (Optional)
SUBDL_API_KEY=your_subdl_api_key_here

# CDN Rate-Limit Token Bucket (Optional — tune these if you get 429 errors on seeks)
# CDN_MAX_REQUESTS=3        # Max requests allowed per window (default: 3)
# CDN_WINDOW_MS=10000       # Sliding window size in milliseconds (default: 10s)
# CDN_BAN_COOLDOWN_MS=15000 # Cooldown after receiving a real 429 from CDN (default: 15s)

# Media Proxy Mode
# true  (default) = proxy video bytes through server — CDN URL never exposed, but rate-limits apply
# false           = redirect browser directly to CDN — no rate-limits, but CDN URL visible in Network tab
# MEDIA_PROXY=true
