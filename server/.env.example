# Server / Backend Environment Configuration

# Primary API Upstream & Endpoints (Required)
BASE_URL=https://api.example.com
MIRROR_URL=https://mirror.example.com
H5_API=https://h5.example.com
DEFAULT_DOMAIN=example.com
WEB_BFF_PATH=/api/web/v1
H5_BFF_PATH=/api/h5/v1
PLAY_PATH=/api/play/v1
H5_HOST_QUERY=

# Allowed Hosts & Suffixes (Required, comma-separated)
SITE_HOSTS=example.com,api.example.com
PLAY_HOSTS=play.example.com,media.example.com
MEDIA_ALLOW_SUFFIXES=m3u8,mp4,ts,m4s

# Upstream Request Headers (Required)
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64)
CLIENT_TIMEZONE=Asia/Karachi
REQUEST_LANG=en-US
CLIENT_TYPE=web

# Server & Proxy Settings
PORT=8788
MAX_MEDIA_PROXY=3

# Security & CORS (Optional)
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGIN_SUFFIXES=example.com
APP_CLIENT_KEY=your_secret_app_client_key_here
ADMIN_API_KEY=your_admin_api_key_here

# Postgres (Prisma) — required for auth, sync, and device access
DATABASE_URL=postgresql://user:password@localhost:5432/moviehunter?schema=public

# Auth (Node play-relay)
AUTH_JWT_SECRET=change_me_to_a_long_random_secret
APP_PUBLIC_URL=http://localhost:3001
MOBILE_AUTH_REDIRECT=moviehunter://account
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the public callback URL (Worker or Node)
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/api/auth/google/callback

# Nodemailer SMTP (verification emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=MovieHunter <noreply@example.com>

# Worker → Node proxy (wrangler .dev.vars / Cloudflare dashboard)
# Local: play-relay on 8788. Production: public URL of your Node API.
NODE_API_URL=http://127.0.0.1:8788

# Third-Party API Integrations (Optional)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SUBDL_API_KEY=your_subdl_api_key_here

# Audius Music API (Optional)
AUDIUS_API_BASE=https://discoveryprovider.audius.co
AUDIUS_APP_NAME=MovieHunter
AUDIUS_WEB_BASE=https://audius.co

# Setup notes:
# 1. Copy this file to .env and .dev.vars (Worker loads .dev.vars)
# 2. npm run prisma:migrate   (or prisma:deploy in prod)
# 3. Run play-relay (auth/sync/access) + wrangler (catalog)
# 4. Configure Google OAuth authorized redirect URI to GOOGLE_REDIRECT_URI
