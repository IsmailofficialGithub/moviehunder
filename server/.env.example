# Server / Backend Environment Configuration

# Primary API Upstream & Endpoints (Required)
BASE_URL=https://api.example.com
MIRROR_URL=https://mirror.example.com
H5_API=https://h5.example.com
DEFAULT_DOMAIN=example.com
WEB_BFF_PATH=/api/web/v1
H5_BFF_PATH=/api/h5/v1
PLAY_PATH=/api/play/v1
H5_HOST_QUERY=

# Allowed Hosts & Suffixes (Required, comma-separated)
SITE_HOSTS=example.com,api.example.com
PLAY_HOSTS=play.example.com,media.example.com
MEDIA_ALLOW_SUFFIXES=m3u8,mp4,ts,m4s

# Upstream Request Headers (Required)
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64)
CLIENT_TIMEZONE=Asia/Karachi
REQUEST_LANG=en-US
CLIENT_TYPE=web

# Server & Proxy Settings
PORT=8788
MAX_MEDIA_PROXY=3

# Security & CORS (Optional)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGIN_SUFFIXES=example.com
APP_CLIENT_KEY=your_secret_app_client_key_here

# Third-Party API Integrations (Optional)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SUBDL_API_KEY=your_subdl_api_key_here

# Audius Music API (Optional)
AUDIUS_API_BASE=https://discoveryprovider.audius.co
AUDIUS_APP_NAME=MovieHunter
AUDIUS_WEB_BASE=https://audius.co
